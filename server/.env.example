# ============================================================================
# JoyFlow e-commerce — Express API environment template
#
# Copy to server/.env on the production Ubuntu VPS:
#   cp server/.env.example server/.env
#   nano server/.env
#
# NEVER commit server/.env. It stays on the server. These are real values —
# leave them blank in local development until PayRam is configured.
# ============================================================================

# Backend port. Kept at 5000 for the PM2/Nginx proxy (see ecosystem.config.cjs
# and deployment/nginx.conf). Do not expose this port to the public network.
PORT=5000

# Exact origin of the React frontend served by Nginx. Controls CORS only.
# In production this is your full https origin, e.g. https://your-domain.com
CLIENT_URL=http://localhost:5173

# --- PayRam gateway (https://payram.com) -----------------------------------
# Base API origin WITHOUT trailing slash, path or credentials:
#   https://gateway.payram.com
PAYRAM_API_URL=

# Project API key from the PayRam dashboard. Server-side only; never expose in
# the React app.
PAYRAM_API_KEY=

# PayRam signs webhooks with the PROJECT API KEY. Leave blank here to reuse
# PAYRAM_API_KEY. If you DO set it, it must equal that key — never invent a
# separate webhook secret.
PAYRAM_WEBHOOK_SECRET=

# Merchant public cold-wallet address that receives the crypto payout.
MERCHANT_WALLET_ADDRESS=

# Crypto settlement asset and network. Confirm your wallet/asset/network is
# configured in PayRam first.
CRYPTO_ASSET=USDT
CRYPTO_NETWORK=BASE

# Enable cards only after testing in PayRam; keep false until verified.
PAYRAM_CARD_ENABLED=false

# Set true ONLY after you confirmed the matching wallet/asset/network in PayRam.
PAYRAM_WALLET_CONFIGURED=false

NODE_ENV=production
